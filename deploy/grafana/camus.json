            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(camus_fetch_request_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
